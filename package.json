{
  "name": "RNBoilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "androidDevDebug": "react-native run-android --mode=devDebug --active-arch-only --appIdSuffix dev",
    "androidStagingDebug": "react-native run-android --mode=stagingDebug --active-arch-only --appIdSuffix staging",
    "androidProdDebug": "react-native run-android --mode=prodDebug --active-arch-only",
    "androidDevApk": "cd android && ./gradlew assembleDevRelease",
    "androidProdApk": "cd android && ./gradlew assembleProdRelease",
    "androidStagingApk": "cd android && ./gradlew assembleStagingRelease",
    "androidDevBundle": "cd android && ./gradlew bundleDevRelease",
    "androidProdBundle": "cd android && ./gradlew bundleProdRelease",
    "androidStagingBundle": "cd android && ./gradlew bundleStagingRelease",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "clean-android": "cd android && ./gradlew clean",
    "ios": "react-native run-ios",
    "clean-ios": "rm -rf ios/build && rm -rf ios/Pods && rm -rf ios/Podfile.lock  && cd ios && pod cache clean --all && pod repo update && pod install",
    "pods": "cd ios && pod install",
    "node:clean": "rm -rf node_modules && yarn cache clean && yarn install",
    "patchPackage": "patch-package",
    "lint": "eslint .",
    "test": "jest --forceExit",
    "generate": "node scripts/generate.js",
    "generate-keystore": "keytool -genkey -v -keystore my-upload-key.keystore -alias my-key-alias -keyalg RSA -keysize 2048 -validity 10000"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "@reduxjs/toolkit": "^2.8.2",
    "dayjs": "^1.11.18",
    "react": "19.2.3",
    "react-hook-form": "^7.59.0",
    "react-native": "0.85.3",
    "react-native-config": "1.5.6",
    "react-native-date-picker": "^5.0.13",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "3.1.0",
    "react-native-image-crop-picker": "^0.51.0",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-modal": "^13.0.1",
    "react-native-otp-entry": "1.8.6",
    "react-native-permissions": "^5.6.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.26.2",
    "react-native-splash-view": "^0.0.19",
    "react-native-svg": "15.15.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "0.11.3",
    "react-redux": "^9.2.0",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "rn-international-phone-number": "^0.14.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^9.23.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/redux-logger": "^3.0.13",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
