{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "~*": ["src/*"]
    },
    "lib": ["ES2022", "DOM"],
    "jsx": "react-native",
    "skipLibCheck": true
  },
  "exclude": ["**/node_modules", "**/Pods"]
}
